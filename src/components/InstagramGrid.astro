---
import { Image } from 'astro:assets';
import { getInstagramPosts } from '../lib/instagram';

interface Props {
	username: string;
	limit?: number;
}

const { username, limit = 9 } = Astro.props;
const posts = await getInstagramPosts(limit);
---

{posts.length > 0 && (
	<section class="ig">
		<ul class="grid">
			{posts.map((post) => (
				<li>
					<a href={post.permalink} target="_blank" rel="noopener">
						<Image
							src={post.image}
							alt={post.caption?.split('\n')[0] || `Photo by @${username}`}
							width={400}
							height={400}
							fit="cover"
							format="webp"
							quality={75}
						/>
					</a>
				</li>
			))}
		</ul>
		<p class="more">
			More on <a href={`https://instagram.com/${username}`}>@{username}</a>
		</p>
	</section>
)}

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.grid a {
		display: block;
		border: none;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 3px;
		background: var(--bg-raised);
	}

	.grid img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: opacity 0.15s;
	}

	.grid a:hover img {
		opacity: 0.8;
	}

	.more {
		margin-top: 0.75rem;
		color: var(--text-faint);
		font-size: 0.85rem;
	}
</style>

---
import Layout from '../../layouts/Layout.astro';

const projects = [
	{
		name: 'CIFAR-10 ResNet Hyperparameter Tuning',
		description: '95% test accuracy on CIFAR-10 with <5M parameters using a modified ResNet-18 ([2,1,1,1] block config). Systematic search across 15+ experiments: 85% baseline → 90% (LR scheduling) → 94% (cyclic momentum) → 95% (exponential decay at 100 epochs).',
		href: 'https://github.com/MihirUpasani/CIFAR10-ResNet18',
		tags: ['PyTorch', 'CUDA'],
	},
	{
		name: 'CIFAR-10 ResNet-50 with Test-Time Augmentation',
		description: 'Full ResNet-50 (Bottleneck [3,4,6,3]) with SGD + Nesterov momentum and ReduceLROnPlateau, multi-GPU support. Achieved 92%+ accuracy with test-time augmentation.',
		href: 'https://github.com/MihirUpasani/CIFAR10-TTA92-ResNet',
		tags: ['PyTorch', 'CUDA', 'Multi-GPU'],
	},
	{
		name: 'Learning Rate vs Batch Size Experiments',
		description: "Reproduction of Smith et al.'s \"Don't Decay the Learning Rate, Increase the Batch Size\" (arXiv:1711.00489). Empirically validated batch-size scaling as a substitute for LR decay, implemented cyclical LRs, and analyzed the noise ratio (LR / batch size) as the governing variable.",
		href: 'https://github.com/MihirUpasani/LearningRatevsBatchSize',
		tags: ['Python', 'PyTorch', 'Jupyter'],
	},
];
---

<Layout title="Projects">
	<h1>Projects</h1>
	<p>
		I do projects on a need-to basis: if I want to learn something and have the time,
		I take a shot at it. Most of what's here is grad work from NYU, mostly distributed
		ML stuff.
	</p>

	<ul class="project-list">
		{projects.map((project) => (
			<li>
				<h2><a href={project.href}>{project.name}</a></h2>
				<p>{project.description}</p>
				<p class="tags">{project.tags.join(' · ')}</p>
			</li>
		))}
	</ul>
</Layout>

<style>
	.project-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.project-list li {
		margin-bottom: 2.5rem;
	}

	.project-list h2 {
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}

	.tags {
		color: var(--text-faint);
		font-size: 0.85rem;
	}
</style>

	<ul>
		<li>Email: <a href="mailto:[PLACEHOLDER: email@example.com]">[PLACEHOLDER: email@example.com]</a></li>
		<li>GitHub: <a href="https://github.com/MihirUpasani">github.com/MihirUpasani</a></li>
		<li>[PLACEHOLDER: LinkedIn / X / other links]</li>
	</ul>
</Layout>

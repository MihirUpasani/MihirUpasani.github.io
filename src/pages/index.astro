---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { isLive } from '../lib/posts';

const recent = (await getCollection('blog', isLive))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title="Home">
	<h1>Mihir Upasani</h1>

	<p>
		ML engineer at DataNimbus. I build machine learning systems on Databricks: the
		models, and the less glamorous plumbing that gets them into production and keeps
		them there.
	</p>

	<p>
		Lately that has meant building a multi-tenant ML experimentation platform on
		Databricks Apps, and finding out exactly where the platform bends. I write up the
		parts that aren't documented anywhere else.
	</p>

	<p>
		Open to new roles and good tech conversations. <a href="/contact/">Hit me up</a>.
	</p>

	{recent.length > 0 && (
		<section>
			<h2>Recent writing</h2>
			<ul class="post-list">
				{recent.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						<p class="desc">{post.data.description}</p>
					</li>
				))}
			</ul>
		</section>
	)}

	<p>
		More on <a href="/about/">about</a>, <a href="/projects/">projects</a>,
		the <a href="/blog/">blog</a>, or how to <a href="/contact/">get in touch</a>.
	</p>
</Layout>

<style>
	h2 {
		font-size: 1rem;
		color: var(--text-dim);
		margin-top: 2.5rem;
	}

	.post-list {
		list-style: none;
		margin: 0 0 2.5rem;
		padding: 0;
	}

	.post-list li {
		margin-bottom: 1.25rem;
	}

	.desc {
		margin: 0.15rem 0 0;
		color: var(--text-faint);
		font-size: 0.85rem;
	}
</style>

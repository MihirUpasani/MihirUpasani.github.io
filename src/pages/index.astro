---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="Home">
	<h1>Mihir Upasani</h1>

	<!-- PLACEHOLDER: replace with your real one-line pitch / role -->
	<p>
		[PLACEHOLDER: one-line intro — who you are, what you work on, e.g. "Software
		engineer working on X. I write about Y and tinker with Z."]
	</p>

	<!-- PLACEHOLDER: a few sentences of personality/voice, in the style of the
	     reference sites — conversational but credible. What are you into outside
	     of work? What's the one thing you want a visitor to remember? -->
	<p>
		[PLACEHOLDER: 2-3 sentences of personal voice/hooks — hobbies, interests,
		what you're currently curious about.]
	</p>

	<p>
		Find more on <a href={`${base}about/`}>about</a>, <a href={`${base}projects/`}>projects</a>,
		the <a href={`${base}blog/`}>blog</a>, or how to <a href={`${base}contact/`}>get in touch</a>.
	</p>
</Layout>

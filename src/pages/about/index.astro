---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About">
	<h1>About</h1>

	<!-- PLACEHOLDER: your background — career path, what you do day to day.
	     Keep it in your own voice, not a resume dump. -->
	<p>
		[PLACEHOLDER: background paragraph — where you've worked, what you
		specialize in, how you got here.]
	</p>

	<!-- PLACEHOLDER: hobbies / interests outside of work -->
	<h2>Outside of work</h2>
	<p>
		[PLACEHOLDER: hobbies, interests, things you're currently learning or
		obsessed with.]
	</p>

	<!-- PLACEHOLDER: optional - now/currently section -->
	<h2>Right now</h2>
	<ul>
		<li>[PLACEHOLDER: what you're currently working on]</li>
		<li>[PLACEHOLDER: what you're currently reading/learning]</li>
	</ul>
</Layout>

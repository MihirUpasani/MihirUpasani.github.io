---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { isLive, statusLabel } from '../../lib/posts';

export async function getStaticPaths() {
	// Drafts and not-yet-released posts get no page in production, so their URLs don't exist.
	const posts = await getCollection('blog', isLive);
	return posts.map((post) => ({
		params: { id: post.id },
		props: {
			post,
			seriesParts: post.data.series
				? posts
						.filter((p) => p.data.series === post.data.series)
						.sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
				: [],
		},
	}));
}

const { post, seriesParts } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
	<article>
		<h1>{post.data.title}</h1>
		<p class="date">
			{post.data.pubDate.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
			{statusLabel(post)}
		</p>
		{seriesParts.length > 1 && (
			<nav class="series" aria-label="Series">
				<p class="series-title">Part {post.data.part} of the series</p>
				<ol>
					{seriesParts.map((p) => (
						<li>
							{p.id === post.id ? (
								<span aria-current="page">{p.data.title}</span>
							) : (
								<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							)}
							{statusLabel(p) && <span class="draft-tag">{statusLabel(p)}</span>}
						</li>
					))}
				</ol>
			</nav>
		)}
		<Content />
	</article>
	<p><a href="/blog/">&larr; back to blog</a></p>
</Layout>

<script is:inline type="module">
	// Render ```mermaid code blocks as diagrams; only loads mermaid on posts that use it.
	const blocks = document.querySelectorAll('pre > code.language-mermaid');
	if (blocks.length) {
		const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs');
		blocks.forEach((code) => {
			const div = document.createElement('div');
			div.className = 'mermaid';
			div.textContent = code.textContent;
			code.parentElement.replaceWith(div);
		});
		mermaid.initialize({
			startOnLoad: false,
			theme: 'base',
			themeVariables: {
				darkMode: true,
				fontFamily: "'SF Mono', ui-monospace, Menlo, Consolas, monospace",
				fontSize: '13px',
				background: '#14171b',
				primaryColor: '#1b2026',
				primaryTextColor: '#e6e8eb',
				primaryBorderColor: '#4c8a52',
				secondaryColor: '#14171b',
				tertiaryColor: '#0b0d10',
				lineColor: '#9aa2ad',
				textColor: '#e6e8eb',
				clusterBkg: '#0b0d10',
				clusterBorder: '#2a2f36',
				edgeLabelBackground: '#14171b',
				actorBkg: '#1b2026',
				actorBorder: '#4c8a52',
				noteBkgColor: '#2a2f36',
				noteTextColor: '#e6e8eb',
				noteBorderColor: '#5f6773',
			},
		});
		await mermaid.run({ querySelector: '.mermaid' });
	}
</script>

<style>
	.date {
		color: var(--text-faint);
		font-size: 0.85rem;
		margin-top: -0.5rem;
	}

	.series {
		margin: 1.5rem 0 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--bg-raised);
		font-size: 0.9rem;
	}

	.series-title {
		margin: 0 0 0.5rem;
		color: var(--text-dim);
	}

	.series ol {
		margin: 0;
		padding-left: 1.4rem;
	}

	.series [aria-current] {
		color: var(--text);
		font-weight: 600;
	}

	.draft-tag {
		color: var(--text-faint);
	}

	article :global(.mermaid) {
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 1rem;
		margin: 1.5rem 0;
		overflow-x: auto;
		text-align: center;
	}
</style>
